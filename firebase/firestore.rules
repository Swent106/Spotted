rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}: uid, name, phone, email, and homeArea are required strings.
    // phone and homeArea may be empty; all fields have size limits below.
    // The document ID and uid field identify the authenticated profile owner.
    // pets/{petId}: ownerId, name, species, breed, photoUrl, allergies,
    // behaviors, and note; existing pet authorization rules are unchanged.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId;
    }

    function uidNotModified(userId) {
      return resource.data.uid == userId
          && request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'email', 'homeArea'])
          && data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'homeArea'])
          && data.uid is string
          && data.uid.size() > 0
          && data.uid.size() <= 128
          && data.uid == userId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100
          && data.phone is string
          && data.phone.size() <= 32
          && data.email is string
          && data.email.size() > 0
          && data.email.size() <= 254
          && data.homeArea is string
          && data.homeArea.size() <= 120;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
          && uidUnchanged(userId)
          && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId)
          && uidNotModified(userId)
          && isValidUser(request.resource.data, userId);
    }

    match /pets/{petId} {
      allow create: if request.auth != null
          && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if request.auth != null
          && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid;
    }

    match /alerts/{alertId} {

      function ownsPet(pid) {
        let petPath = /databases/$(database)/documents/pets/$(pid);
        return exists(petPath) && get(petPath).data.ownerId == request.auth.uid;
      }

      function validLocation(l) {
        return l is map
          && l.keys().hasOnly(['latitude', 'longitude'])
          && l.latitude is number && l.latitude >= -90 && l.latitude <= 90
          && l.longitude is number && l.longitude >= -180 && l.longitude <= 180;
      }

      // Full schema of an alert document (matches AlertDto on the Android side)
      function validAlert(d) {
        return d.keys().hasAll([
                'id', 'petId', 'ownerId', 'lastKnownLocation', 'lostAtMillis', 'status',
                'petName', 'petSpecies', 'petAllergies', 'petBehaviors'])
          && d.keys().hasOnly([
                'id', 'petId', 'ownerId', 'lastKnownLocation', 'lostAtMillis', 'status',
                'petName', 'petSpecies', 'petPhotoUrl', 'petAllergies', 'petBehaviors'])
          && d.id == alertId
          && d.petId is string && d.petId.size() > 0
          && d.ownerId is string
          && validLocation(d.lastKnownLocation)
          && d.lostAtMillis is int
          && d.status in ['OPEN', 'CLOSED']
          && d.petName is string && d.petName.size() > 0 && d.petName.size() <= 100
          && d.petSpecies is string && d.petSpecies.size() <= 50
          && (!('petPhotoUrl' in d) || d.petPhotoUrl == null
              || (d.petPhotoUrl is string && d.petPhotoUrl.size() <= 2048))
          && d.petAllergies is list && d.petAllergies.size() <= 50
          && d.petBehaviors is list && d.petBehaviors.size() <= 50;
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;

      allow create: if request.auth != null
          && validAlert(request.resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.status == 'OPEN'
          && ownsPet(request.resource.data.petId);

      // The owner may only close the alert or move it; identity fields are immutable.
      allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && validAlert(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'lastKnownLocation']);

      allow delete: if request.auth != null
          && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
