// Portions of this code were generated with the help of Claude (Anthropic).
rules_version = '2';
// Portions of this code were generated with the help of Claude (Anthropic).
// Portions of this code were generated with the help of Copilot.

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}: uid, name, phone, email, and homeArea are required strings;
    // username is an optional string (see isValidUser).
    // phone and homeArea may be empty; all fields have size limits below.
    // The document ID and uid field identify the authenticated profile owner.
    // pets/{petId}: ownerId, name, species, breed, photoUrl, allergies,
    // behaviors, and note; existing pet authorization rules are unchanged.
    // sightings/{sightingId}: id, reporterId, location, seenAtMillis, species,
    // and optional photoUrl, alertId, status and headingDegrees (null or 0..359);
    // only the reporter may change or delete them until the alert owner reviews it.
    // trustVerdict (CONFIRMED or FALSE) is set once, when the sighting moves its
    // reporter's trust score (see trust/{uid}).

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId;
    }

    function uidNotModified(userId) {
      return resource.data.uid == userId
          && request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'email', 'homeArea'])
          && data.keys().hasOnly([
                'uid', 'name', 'username', 'phone', 'email', 'homeArea',
                'homeLatitude', 'homeLongitude', 'alertRadiusKm'])
          && data.uid is string
          && data.uid.size() > 0
          && data.uid.size() <= 128
          && data.uid == userId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 100
          // Optional here, required by the app: the M2 APK doesn't send it.
          // Make it required once nobody uses that APK anymore.
          && (!('username' in data)
              || (data.username is string
                  && data.username.size() > 0
                  && data.username.size() <= 30))
          && data.phone is string
          && data.phone.size() <= 32
          && data.email is string
          && data.email.size() > 0
          && data.email.size() <= 254
          && data.homeArea is string
          && data.homeArea.size() <= 120
          // Optional: the home pin and the alert radius (one of the radius chips)
          && (!('homeLatitude' in data) || data.homeLatitude == null
              || (data.homeLatitude is number
                  && data.homeLatitude >= -90 && data.homeLatitude <= 90))
          && (!('homeLongitude' in data) || data.homeLongitude == null
              || (data.homeLongitude is number
                  && data.homeLongitude >= -180 && data.homeLongitude <= 180))
          && (!('alertRadiusKm' in data) || data.alertRadiusKm in [1, 3, 5, 10]);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
          && uidUnchanged(userId)
          && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId)
          && uidNotModified(userId)
          && isValidUser(request.resource.data, userId);
      // Lets users delete their own account
      allow delete: if isOwner(userId);
    }

    match /pets/{petId} {
      allow create: if request.auth != null
          && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if request.auth != null
          && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid;
    }

    match /alerts/{alertId} {

      function ownsPet(pid) {
        let petPath = /databases/$(database)/documents/pets/$(pid);
        return exists(petPath) && get(petPath).data.ownerId == request.auth.uid;
      }

      function validLocation(l) {
        return l is map
          && l.keys().hasOnly(['latitude', 'longitude'])
          && l.latitude is number && l.latitude >= -90 && l.latitude <= 90
          && l.longitude is number && l.longitude >= -180 && l.longitude <= 180;
      }

      // Full schema of an alert document (matches AlertDto on the Android side)
      function validAlert(d) {
        return d.keys().hasAll([
                'id', 'petId', 'ownerId', 'lastKnownLocation', 'lostAtMillis', 'status',
                'petName', 'petSpecies', 'petAllergies', 'petBehaviors'])
          && d.keys().hasOnly([
                'id', 'petId', 'ownerId', 'lastKnownLocation', 'lostAtMillis', 'closedAtMillis',
                'status', 'petName', 'petSpecies', 'petPhotoUrl', 'petAllergies', 'petBehaviors',
                'lastSeenAtMillis', 'lossCause', 'lossEnvironment'])
          && d.id == alertId
          && d.petId is string && d.petId.size() > 0
          && d.ownerId is string
          && validLocation(d.lastKnownLocation)
          && d.lostAtMillis is int
          && d.status in ['OPEN', 'CLOSED']
          // An open alert has no closing time (the app writes null). A closed one must have one,
          // after it was lost and not in the future: the time comes from the phone, so a minute
          // of clock difference with the server is accepted.
          && (d.status == 'OPEN'
              ? d.get('closedAtMillis', null) == null
              : (d.get('closedAtMillis', null) is int
                  && d.closedAtMillis >= d.lostAtMillis
                  && d.closedAtMillis <= request.time.toMillis() + 60000))
          && d.petName is string && d.petName.size() > 0 && d.petName.size() <= 100
          && d.petSpecies is string && d.petSpecies.size() <= 50
          && (!('petPhotoUrl' in d) || d.petPhotoUrl == null
              || (d.petPhotoUrl is string && d.petPhotoUrl.size() <= 2048))
          && d.petAllergies is list && d.petAllergies.size() <= 50
          && d.petBehaviors is list && d.petBehaviors.size() <= 50
          // Set when a confirmed sighting moves the last seen place: after the pet was lost, and
          // at most 5 minutes in the future, like a sighting
          && (d.get('lastSeenAtMillis', null) == null
              || (d.lastSeenAtMillis is int
                  && d.lastSeenAtMillis >= d.lostAtMillis
                  && d.lastSeenAtMillis <= request.time.toMillis() + 300000))
          // Optional circumstances of the loss (older alerts don't have them). Set when the
          // alert is published: they are not in the fields an update may change.
          && (!('lossCause' in d) || d.lossCause in [
                'ESCAPED_FROM_HOME', 'DURING_A_WALK', 'SCARED_BY_NOISE', 'DURING_MOVE_OR_TRIP',
                'STOLEN', 'UNKNOWN'])
          && (!('lossEnvironment' in d) || d.lossEnvironment in [
                'CITY_CENTRE', 'SUBURB', 'VILLAGE_OR_RURAL', 'FOREST_OR_MOUNTAIN', 'UNKNOWN']);
      }

      // The last seen time only moves forward: an older sighting can't move the pet back
      function lastSeenNotMovedBack() {
        let before = resource.data.get('lastSeenAtMillis', null);
        let after = request.resource.data.get('lastSeenAtMillis', null);
        return after == before
          || (after != null && after > (before == null ? resource.data.lostAtMillis : before));
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;

      allow create: if request.auth != null
          && validAlert(request.resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.status == 'OPEN'
          && ownsPet(request.resource.data.petId)
          // One open alert per pet: the pet's lock must name this alert once the write is done
          // (see openPetAlerts below, which refuses to move a lock off an open alert)
          && getAfter(/databases/$(database)/documents/openPetAlerts/$(request.resource.data.petId))
               .data.alertId == alertId;

      // The owner may only close an open alert or move it (last seen place and time); identity
      // fields are immutable.
      // A closed alert is frozen, so nobody can reopen it. Alerts written before the status
      // field existed count as open.
      allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && resource.data.get('status', 'OPEN') == 'OPEN'
          && validAlert(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'lastKnownLocation', 'closedAtMillis', 'lastSeenAtMillis'])
          && lastSeenNotMovedBack();

      allow delete: if request.auth != null
          && resource.data.ownerId == request.auth.uid;
    }

    // openPetAlerts/{petId}: alertId of the pet's latest alert and its ownerId. Written by
    // AlertRepositoryFirestore.publishAlert in the same transaction as the alert, so a pet never
    // gets two open alerts. Only the pet's owner may read or change it.
    match /openPetAlerts/{petId} {
      function ownsLockedPet() {
        let petPath = /databases/$(database)/documents/pets/$(petId);
        return exists(petPath) && get(petPath).data.ownerId == request.auth.uid;
      }

      function validLock(d) {
        return d.keys().hasAll(['alertId', 'ownerId'])
          && d.keys().hasOnly(['alertId', 'ownerId'])
          && d.alertId is string && d.alertId.size() > 0 && d.alertId.size() <= 128
          && d.ownerId == request.auth.uid;
      }

      // The lock may only move to another alert once the one it names is closed or gone
      // True if the alert the lock names is closed or gone, so the pet is free
      function namedAlertNotOpen() {
        let alertPath = /databases/$(database)/documents/alerts/$(resource.data.alertId);
        return !exists(alertPath) || get(alertPath).data.get('status', 'OPEN') != 'OPEN';
      }

      // The lock may only move to another alert once the one it names is closed or gone
      function lockedAlertFree() {
        return request.resource.data.alertId == resource.data.alertId || namedAlertNotOpen();
      }

      // A pet without a lock yet reads as missing, which the transaction needs to see
      allow get: if isAuthenticated()
          && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid
          && request.query.limit <= 100;
      allow create: if isAuthenticated()
          && validLock(request.resource.data)
          && ownsLockedPet();
      allow update: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid
          && validLock(request.resource.data)
          && ownsLockedPet()
          && lockedAlertFree();
      // Same check, or deleting the lock would let a second open alert in
      // (deleteAlertsByOwner deletes the alerts first)
      allow delete: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid
          && namedAlertNotOpen();
    }

    match /sightings/{sightingId} {

      function validSightingLocation(l) {
        return l is map
          && l.keys().hasOnly(['latitude', 'longitude'])
          && l.latitude is number && l.latitude >= -90 && l.latitude <= 90
          && l.longitude is number && l.longitude >= -180 && l.longitude <= 180;
      }

      // A list of enum names: missing, or a list without duplicates and with only allowed values.
      function validEnumList(d, key, allowed) {
        let l = d.get(key, []);
        return l is list && l.hasOnly(allowed) && l.toSet().size() == l.size();
      }

      // Optional animal details (names of the AnimalActivity, AnimalCondition, AnimalReaction,
      // PlaceType and CollarStatus enums). Sightings saved before them have none: the lists count
      // as empty and the single values as UNKNOWN. LOOKS_FINE excludes every other condition.
      function validSightingDetails(d) {
        return validEnumList(d, 'activities', [
                'WALKING', 'RUNNING', 'CROSSING_ROAD', 'RESTING', 'SLEEPING', 'HIDING', 'EATING',
                'DRINKING', 'SCAVENGING', 'HUNTING', 'SNIFFING_EXPLORING', 'FOLLOWING_PEOPLE',
                'PLAYING_WITH_PEOPLE', 'WITH_OTHER_ANIMALS', 'FIGHTING', 'VOCALIZING'])
          && validEnumList(d, 'conditions', [
                'LOOKS_FINE', 'INJURED', 'LIMPING', 'BLEEDING', 'THIN', 'LOOKS_SICK', 'EXHAUSTED',
                'DIRTY', 'WET'])
          && (!('LOOKS_FINE' in d.get('conditions', [])) || d.conditions.size() == 1)
          && validEnumList(d, 'reactions', [
                'CAME_CLOSER', 'FOLLOWED_ME', 'LET_ITSELF_BE_TOUCHED', 'ACCEPTED_FOOD', 'IGNORED_ME',
                'KEPT_ITS_DISTANCE', 'RAN_AWAY', 'HID', 'GROWLED_OR_HISSED', 'SNAPPED_OR_ATTACKED'])
          && d.get('placeType', 'UNKNOWN')
              in ['STREET', 'PARK', 'GARDEN', 'FIELD', 'FOREST', 'INSIDE_BUILDING', 'UNKNOWN']
          && d.get('collar', 'UNKNOWN') in ['WORE_COLLAR', 'NO_COLLAR', 'UNKNOWN'];
      }

      // Full schema of a sighting document (matches SightingRepositoryFirestore).
      // species and status must be names of the Species and SightingStatus enums.
      function validSighting(d, previousHeadingDegrees) {
        return d.keys().hasAll(['id', 'reporterId', 'location', 'seenAtMillis', 'species'])
          && d.keys().hasOnly([
                'id', 'reporterId', 'location', 'seenAtMillis', 'species', 'photoUrl', 'alertId',
                'status', 'headingDegrees', 'activities', 'conditions', 'reactions', 'placeType',
                'collar', 'trustVerdict'])
          && d.get('status', 'PENDING') in ['PENDING', 'CONFIRMED', 'DISMISSED']
          && d.get('trustVerdict', 'CONFIRMED') in ['CONFIRMED', 'FALSE']
          && validSightingDetails(d)
          && d.id == sightingId
          && d.reporterId is string
          && validSightingLocation(d.location)
          && d.seenAtMillis is int
          && d.species in ['DOG', 'CAT', 'OTHER']
          && (!('photoUrl' in d) || d.photoUrl == null
              || (d.photoUrl is string && d.photoUrl.size() <= 2048))
          && (!('alertId' in d) || d.alertId == null
              || (d.alertId is string && d.alertId.size() > 0 && d.alertId.size() <= 128))
          && (!('headingDegrees' in d) || d.headingDegrees == null
              || ((d.headingDegrees is int
                   && d.headingDegrees >= 0 && d.headingDegrees <= 359)
                  || (d.headingDegrees is number
                      && d.headingDegrees >= 0 && d.headingDegrees <= 359
                      && d.headingDegrees == previousHeadingDegrees)));

      }

      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;

      // Sightings saved before the status existed have none: they count as PENDING.
      function statusOf(d) {
        return d.get('status', 'PENDING');
      }

      // True if the signed-in user owns the alert the existing sighting is linked to.
      function ownsLinkedAlert() {
        let alertId = resource.data.get('alertId', null);
        let alertPath = /databases/$(database)/documents/alerts/$(alertId);
        return alertId is string
          && exists(alertPath)
          && get(alertPath).data.ownerId == request.auth.uid;
      }

      // A new sighting is at most 5 minutes in the future (clocks are not always in sync).
      function notInTheFuture(d) {
        return d.seenAtMillis <= request.time.toMillis() + 300000;
      }

      // A new sighting may only be linked to an open alert of another user.
      function canBeLinkedTo(d) {
        let alertId = d.get('alertId', null);
        let alertPath = /databases/$(database)/documents/alerts/$(alertId);
        return alertId == null
          || (exists(alertPath)
              && get(alertPath).data.status == 'OPEN'
              && get(alertPath).data.ownerId != request.auth.uid);
      }

      // True if the sighting was judged for the trust score of its reporter
      function isJudged(d) {
        return 'trustVerdict' in d;
      }

      allow create: if request.auth != null
          && validSighting(request.resource.data, null)
          && request.resource.data.reporterId == request.auth.uid
          && statusOf(request.resource.data) == 'PENDING'
          && !isJudged(request.resource.data)
          && notInTheFuture(request.resource.data)
          && canBeLinkedTo(request.resource.data);

      // Once linked to an alert, a sighting stays on it (it may still be linked later).
      function alertIdKept() {
        let savedAlertId = resource.data.get('alertId', null);
        return savedAlertId == null
          || request.resource.data.get('alertId', null) == savedAlertId;
      }

      // A sighting linked to an alert later gets the same checks as on create. When the alert
      // stays the same (e.g. it has closed since), the edit isn't refused.
      function linkedAlertAllowed() {
        return request.resource.data.get('alertId', null) == resource.data.get('alertId', null)
          || canBeLinkedTo(request.resource.data);
      }

      // The author may change their sighting until the alert owner reviews it. It stays theirs,
      // on the same alert, and they cannot review it themselves. It gets the same plausibility
      // checks as on create, so they cannot be bypassed by creating first and editing after.
      // A judged sighting is frozen, even if still pending, so it cannot be counted again.
      allow update: if request.auth != null
          && resource.data.reporterId == request.auth.uid
          && statusOf(resource.data) == 'PENDING'
          && !isJudged(resource.data)
          && !isJudged(request.resource.data)
          && validSighting(
              request.resource.data, resource.data.get('headingDegrees', null))
          && request.resource.data.reporterId == resource.data.reporterId
          && statusOf(request.resource.data) == 'PENDING'
          && alertIdKept()
          && notInTheFuture(request.resource.data)
          && linkedAlertAllowed();

      // The owner of the linked alert may confirm or dismiss it, and change nothing else.
      // The status stays explicit once reviewed (it cannot be deleted).
      // The first confirmation must judge the sighting too (next rule), so it moves the trust
      // score of its reporter. Once judged, the status alone may change again.
      allow update: if request.auth != null
          && ownsLinkedAlert()
          && validSighting(
              request.resource.data, resource.data.get('headingDegrees', null))
          && 'status' in request.resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (request.resource.data.status != 'CONFIRMED' || isJudged(resource.data));

      // The owner of the linked alert may judge the sighting for the trust score of its reporter:
      // once, and only in the same write as the trust update it causes (see trust/{uid}).
      // In S6 only a confirmation judges (TrustRepositoryFirestore.confirmSighting): the write
      // must confirm the sighting with a confirmed verdict. So one owner, even a new account,
      // cannot lower a reporter's score, nor credit a dismissed sighting. FALSE verdicts come
      // with the votes of US-T2 (#385).
      allow update: if request.auth != null
          && ownsLinkedAlert()
          && validSighting(
              request.resource.data, resource.data.get('headingDegrees', null))
          && !isJudged(resource.data)
          && isJudged(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['trustVerdict', 'status'])
          && request.resource.data.status == 'CONFIRMED'
          && request.resource.data.trustVerdict == 'CONFIRMED'
          && getAfter(/databases/$(database)/documents/trust/$(resource.data.reporterId))
               .data.get('lastSightingId', null) == sightingId;

      // Once reviewed, the sighting is evidence the owner relies on, so it cannot be deleted.
      // A judged one cannot either: created again with the same id, it would be counted twice.
      allow delete: if request.auth != null
          && resource.data.reporterId == request.auth.uid
          && statusOf(resource.data) == 'PENDING'
          && !isJudged(resource.data);
    }

    // Photos of pets and sightings, saved in base64 by PhotoRepositoryFirestore (no Storage).
    // photos/{id}: ownerId, contentType and data; a document holds at most 1 MiB.
    match /photos/{photoId} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['ownerId', 'contentType', 'data'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.contentType == 'image/jpeg'
          && request.resource.data.data is string
          && (resource == null || resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // petTags/{tagId}: tagId (uppercase hex UID), petId, ownerId, linkedAtMillis,
    // visibility flags, and nullable contact copies are required.
    match /petTags/{tagId} {
      function ownsPet(petId) {
        let petPath = /databases/$(database)/documents/pets/$(petId);
        return isAuthenticated()
          && exists(petPath)
          && get(petPath).data.ownerId == request.auth.uid;
      }

      function isValidPetTag(data) {
        return data.keys().hasAll([
                'tagId', 'petId', 'ownerId', 'linkedAtMillis',
                'showPhone', 'showEmail', 'contactPhone', 'contactEmail'])
          && data.keys().hasOnly([
                'tagId', 'petId', 'ownerId', 'linkedAtMillis',
                'showPhone', 'showEmail', 'contactPhone', 'contactEmail'])
          && data.tagId == tagId
          && data.tagId is string
          && data.tagId.matches('^[0-9A-F]{1,32}$')
          && data.petId is string
          && data.petId.size() > 0
          && data.petId.size() <= 128
          && data.ownerId is string
          && data.ownerId.size() > 0
          && data.ownerId.size() <= 128
          && data.linkedAtMillis is int
          && data.linkedAtMillis >= 0
          && data.showPhone is bool
          && data.showEmail is bool
          && (data.showPhone || data.showEmail)
          && (data.showPhone || data.contactPhone == null)
          && (data.showEmail || data.contactEmail == null)
          && (data.contactPhone == null
              || (data.contactPhone is string && data.contactPhone.size() <= 32)) //i'll think later how can this be locale specific
          && (data.contactEmail == null
              || (data.contactEmail is string && data.contactEmail.size() <= 254));
      }

      // Known UID lookups are allowed for signed-in users; collection queries are owner-scoped.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
          && isValidPetTag(request.resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && ownsPet(request.resource.data.petId);
      allow update: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid
          && isValidPetTag(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && ownsPet(request.resource.data.petId);
      allow delete: if isAuthenticated()
          && resource.data.ownerId == request.auth.uid;
    }

    // trust/{uid}: score (0..1) and judged (count of judged sightings) of a user, and
    // lastSightingId, the sighting judged last. Kept apart from users/{uid}, which holds private
    // contact details, so any signed-in user can see how reliable a helper is.
    // Only TrustRepositoryFirestore (applyVerdict, confirmSighting) writes it: in one transaction,
    // the owner of an alert judges a sighting linked to it (its trustVerdict) and applies that
    // verdict to the trust of its reporter. The constants match TrustRules in model/trust/TrustScore.kt.
    match /trust/{uid} {
      function judgedSightingPath() {
        return /databases/$(database)/documents/sightings/$(request.resource.data.lastSightingId);
      }

      // Score and judged count before this verdict: a user without a document starts at the
      // initial score (TrustRules.INITIAL_SCORE) with nothing judged
      function scoreBefore() {
        return resource == null ? 0.3 : resource.data.score;
      }

      function judgedBefore() {
        return resource == null ? 0 : resource.data.judged;
      }

      // TrustScore.after: a confirmed sighting closes 10% of the gap to 1, a false one halves it.
      // Same operations in the same order as in Kotlin, so the doubles are equal.
      function scoreAfter(verdict) {
        return verdict == 'CONFIRMED'
          ? scoreBefore() + 0.1 * (1 - scoreBefore())
          : scoreBefore() * 0.5;
      }

      function validTrust(d) {
        return d.keys().hasAll(['score', 'judged', 'lastSightingId'])
          && d.keys().hasOnly(['score', 'judged', 'lastSightingId'])
          && d.score is number && d.score >= 0 && d.score <= 1
          && d.judged is int
          && d.lastSightingId is string
          && d.lastSightingId.size() > 0 && d.lastSightingId.size() <= 128;
      }

      // The sighting named by lastSightingId: reported by this user, linked to an alert of the
      // signed-in user, not judged before this write and judged by it.
      function judgesSightingNow() {
        let before = get(judgedSightingPath()).data;
        let alertPath = /databases/$(database)/documents/alerts/$(before.get('alertId', ''));
        return before.reporterId == uid
          && !('trustVerdict' in before)
          && exists(alertPath)
          && get(alertPath).data.ownerId == request.auth.uid
          && 'trustVerdict' in getAfter(judgedSightingPath()).data;
      }

      // One verdict at a time: judged goes up by one and the score is the one it gives
      function appliesOneVerdict() {
        return request.resource.data.judged == judgedBefore() + 1
          && request.resource.data.score
               == scoreAfter(getAfter(judgedSightingPath()).data.trustVerdict);
      }

      allow get: if isAuthenticated();
      allow create, update: if isAuthenticated()
          && validTrust(request.resource.data)
          && exists(judgedSightingPath())
          && judgesSightingNow()
          && appliesOneVerdict();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
